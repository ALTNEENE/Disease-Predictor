{
  "version": 2,
  "installCommand": "pip install -r requirements.txt",
  "buildCommand": "python -m py_compile api/index.py app/main.py",
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
